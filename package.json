    "check": "npm run test && npm run build",
    "qa": "npm run check && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.2",
    "@types/three": "0.185.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "three": "0.185.1"
  }
}
